I have tried with:

unroll_trend <- function(np=1, x="x", y="y") {
    ip <- 0
    res <- character()
    if (np > 0) {
        for (i in (0:np)) {
            for (j in (0:(np - i))) {
                if ((i == 0) & (j == 0)) 
                    next
                else if (i == 0) {
                    ip <- ip + 1
                    res[ip] <- paste("I(", x, "^", j, ")", sep = "")
                } else if (j == 0) {
                    ip <- ip + 1
                    res[ip] <- paste("I(", y, "^", i, ")", sep = "")
                } else {
                    ip <- ip + 1
                    res[ip] <- paste("I(", x, "^", j, "*", 
                        y, "^", i, ")", sep = "")
                }
            }
        }
    }
    res
}

