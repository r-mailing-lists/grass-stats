>>
>> class(
>> .read_vect_plugin2("geonames",
>>                    mapset = NULL,
>>                    layer = 1L,
>>                    sss = sss,
>>                    ignore.stderr = TRUE,
>>                    pointDropZ = TRUE)
>> )
>> Error in ogrInfo(dsn = dsn, layer = layer, encoding = encoding,
>> use_iconv = use_iconv,  :
>>  Cannot open layer
>>
>>
>> class(
>> .read_vect_plugin2("geonames",
>>                     mapset = NULL,
>>                     layer = "geonames",
>>                     sss = sss,
>>                     ignore.stderr = TRUE,
>>                     pointDropZ = TRUE)
